# Запрещает прямую отдачу CSV с персональными данными через веб-сервер.
# Если сайт на nginx — .htaccess не читается, нужно добавить свой deny-блок
# для /api/data/ в конфиге nginx (см. api/README.md).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
